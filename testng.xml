<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Test Suite" parallel="tests" thread-count="3">

    <!-- ================================================================ -->
    <!-- Listeners — applied to all tests in the suite                    -->
    <!-- ================================================================ -->
    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <!-- ================================================================ -->
    <!-- SMOKE TESTS — fast, high-priority, run on every build            -->
    <!-- ================================================================ -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.automation.tests.*"/>
        </packages>
    </test>

    <!-- ================================================================ -->
    <!-- REGRESSION TESTS — full suite, run nightly or before release     -->
    <!-- ================================================================ -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.automation.tests.*"/>
        </packages>
    </test>

</suite>
