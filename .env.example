# ============================================================
# Environment Variables — Copy this file to .env and fill in
# ============================================================
#
# USAGE:
#   1. Copy this file:    cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to Git
#
# These variables override config.properties values.
# The framework reads them via System.getenv() in ConfigManager.
#
# ============================================================

# Application credentials (used for login tests)
APP_USERNAME=Admin
APP_PASSWORD=admin123

# API authentication token (if needed for API tests)
API_TOKEN=

# Environment (dev, staging)
APP_ENV=dev
